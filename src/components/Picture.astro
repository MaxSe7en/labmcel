---
/** Catalogue photographs. Swap the files in /public/photos when you have your own. */
interface Props {
  name: string;
  alt?: string;
}

const { name, alt = "" } = Astro.props;

const photos: Record<string, string> = {
  cassette: "/photos/tests.jpg",
  monitor: "/photos/monitors.jpg",
  rotor: "/photos/lab.jpg",
  suture: "/photos/consumables.jpg",
  probe: "/photos/imaging.jpg",
  bed: "/photos/bed.jpg",
};

const src = photos[name];
---

{
  src && (
    <img
      class="photo"
      src={src}
      alt={alt}
      data-frame={name}
      loading="lazy"
      decoding="async"
    />
  )
}
