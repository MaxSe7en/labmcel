---
/** Catalogue drawings. Same ink, cobalt and oxide palette on every one. */
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<svg class="picture" viewBox="0 0 120 120" aria-hidden="true">
  {
    name === "cassette" && (
      <>
        <rect x="30" y="12" width="60" height="96" rx="8" fill="#1557a6" />
        <rect x="42" y="26" width="36" height="30" rx="3" fill="#ffffff" />
        <rect x="54" y="32" width="3" height="18" fill="#102235" />
        <rect x="66" y="32" width="3" height="18" fill="#087f78" />
        <circle cx="60" cy="76" r="8" fill="#ffffff" />
        <circle cx="60" cy="76" r="3.4" fill="#0f766e" />
        <path d="M46 98h28" stroke="#70c7bf" stroke-width="3" stroke-linecap="round" />
      </>
    )
  }
  {
    name === "monitor" && (
      <>
        <rect x="14" y="18" width="92" height="66" rx="7" fill="#102235" />
        <rect x="22" y="26" width="76" height="46" rx="3" fill="#12304a" />
        <path
          d="M30 54h12l6-14 8 24 7-16h18"
          fill="none"
          stroke="#70c7bf"
          stroke-width="2.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <rect x="50" y="84" width="20" height="7" fill="#1557a6" />
        <rect x="38" y="91" width="44" height="7" rx="1.5" fill="#087f78" />
        <circle cx="28" cy="30" r="2" fill="#0f766e" />
      </>
    )
  }
  {
    name === "rotor" && (
      <>
        <rect x="46" y="14" width="28" height="12" rx="2" fill="#087f78" />
        <rect x="20" y="26" width="80" height="76" rx="10" fill="#1557a6" />
        <circle cx="60" cy="64" r="24" fill="#ffffff" />
        <circle cx="60" cy="64" r="6" fill="#087f78" />
        <circle cx="60" cy="48" r="3.2" fill="#102235" />
        <circle cx="76" cy="64" r="3.2" fill="#102235" />
        <circle cx="60" cy="80" r="3.2" fill="#102235" />
        <circle cx="44" cy="64" r="3.2" fill="#102235" />
        <rect x="86" y="58" width="8" height="14" rx="1.5" fill="#0f766e" />
      </>
    )
  }
  {
    name === "suture" && (
      <>
        <rect x="18" y="64" width="84" height="18" rx="2" fill="#1557a6" />
        <rect x="22" y="50" width="76" height="18" rx="2" fill="#087f78" />
        <rect x="26" y="36" width="68" height="18" rx="2" fill="#ffffff" stroke="#102235" stroke-width="2.5" />
        <path d="M34 44h12M34 48h20" stroke="#1557a6" stroke-width="1.6" stroke-linecap="round" />
        <path
          d="M22 30c16-20 48-14 46 8"
          fill="none"
          stroke="#102235"
          stroke-width="2.6"
          stroke-linecap="round"
        />
        <path d="M66 40l8 3-8 3" fill="#0f766e" />
      </>
    )
  }
  {
    name === "probe" && (
      <>
        <path d="M28 104c8 10 56 10 64 0" fill="none" stroke="#1557a6" stroke-width="2" stroke-linecap="round" />
        <path d="M20 112c12 12 68 12 80 0" fill="none" stroke="#087f78" stroke-width="2" stroke-linecap="round" />
        <rect x="42" y="70" width="36" height="20" rx="6" fill="#087f78" />
        <rect x="48" y="16" width="24" height="60" rx="12" fill="#1557a6" />
        <circle cx="60" cy="36" r="4" fill="#0f766e" />
        <path d="M54 78h12" stroke="#ffffff" stroke-width="2" stroke-linecap="round" />
      </>
    )
  }
  {
    name === "bed" && (
      <>
        <rect x="16" y="28" width="12" height="52" rx="2" fill="#087f78" />
        <rect x="92" y="40" width="10" height="40" rx="2" fill="#102235" />
        <rect x="22" y="46" width="78" height="22" rx="3" fill="#1557a6" />
        <rect x="28" y="50" width="20" height="12" rx="2" fill="#ffffff" />
        <rect x="20" y="68" width="80" height="6" fill="#102235" />
        <circle cx="34" cy="84" r="6" fill="none" stroke="#102235" stroke-width="2.4" />
        <circle cx="86" cy="84" r="6" fill="none" stroke="#102235" stroke-width="2.4" />
        <path d="M78 46v22" stroke="#70c7bf" stroke-width="2" />
      </>
    )
  }
</svg>
