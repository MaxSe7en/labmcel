---
import { site } from "../content/site";
---

<figure class="hero-art">
  <div class="plate">
    <img
      src="/photos/hero.jpg"
      alt={site.ui.fig}
      width="1400"
      height="933"
      fetchpriority="high"
      decoding="async"
    />
    <span class="crops" aria-hidden="true"></span>
  </div>
  <figcaption>{site.ui.fig}</figcaption>
</figure>
