---
import { site } from "../content/site";
---

<figure class="hero-art">
  <div class="plate">
    <span class="crops" aria-hidden="true"></span>
    <svg viewBox="0 0 560 430" role="img" aria-label={site.ui.fig}>
      <path
        d="M118 78c86-64 236-62 332 18"
        fill="none"
        stroke="#087f78"
        stroke-width="13"
        stroke-linecap="round"
      />
      <circle cx="268" cy="52" r="5" fill="#0f766e" />

      <!-- bench -->
      <rect x="28" y="352" width="504" height="11" fill="#102235" />
      <rect x="58" y="363" width="8" height="42" fill="#102235" />
      <rect x="494" y="363" width="8" height="42" fill="#102235" />

      <!-- microscope -->
      <g>
        <rect x="40" y="328" width="132" height="24" rx="12" fill="#1557a6" />
        <rect x="136" y="214" width="16" height="122" rx="8" fill="#1557a6" />
        <rect x="86" y="206" width="66" height="16" rx="8" fill="#1557a6" />
        <rect x="70" y="190" width="24" height="36" rx="12" fill="#087f78" />
        <rect x="62" y="292" width="82" height="8" fill="#102235" />
        <rect x="118" y="264" width="12" height="28" rx="2" fill="#087f78" />
        <rect x="78" y="286" width="26" height="6" fill="#ffffff" />
        <circle cx="162" cy="274" r="8" fill="#0f766e" />
      </g>

      <!-- rapid test -->
      <g>
        <rect x="214" y="188" width="100" height="164" rx="12" fill="#1557a6" />
        <rect x="230" y="206" width="68" height="50" rx="4" fill="#ffffff" />
        <rect x="254" y="216" width="4" height="30" rx="1" fill="#102235" />
        <rect x="274" y="216" width="4" height="30" rx="1" fill="#087f78" />
        <circle cx="264" cy="292" r="14" fill="#ffffff" />
        <circle cx="264" cy="292" r="5.5" fill="#0f766e" />
        <path d="M238 328h52" stroke="#70c7bf" stroke-width="4" stroke-linecap="round" />
      </g>

      <!-- monitor -->
      <g>
        <rect x="356" y="196" width="164" height="108" rx="10" fill="#102235" />
        <rect x="368" y="208" width="140" height="76" rx="4" fill="#12304a" />
        <circle cx="384" cy="224" r="4" fill="#0f766e" />
        <path
          class="ecg"
          pathLength="100"
          d="M384 252h24l12-20 16 36 12-22h48"
          fill="none"
          stroke="#70c7bf"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <rect x="422" y="304" width="36" height="18" fill="#1557a6" />
        <rect x="386" y="322" width="108" height="30" rx="3" fill="#087f78" />
      </g>
    </svg>
  </div>
  <figcaption>{site.ui.fig}</figcaption>
</figure>
