---
import { site, type Category } from "../content/site";
import Picture from "./Picture.astro";
import Icon from "./Icon.astro";

interface Props {
  items?: Category[];
  level?: 2 | 3;
}

const { items = site.categories, level = 3 } = Astro.props;
---

<ul class="index-list">
  {
    items.map((item) => (
      <li>
        <a class="index-row" href={`/products/${item.slug}`}>
          <span class="num">{item.code}</span>
          <span class="thumb">
            <Picture name={item.picture} />
          </span>
          <span class="index-copy">
            {level === 2 ? <h2>{item.title}</h2> : <h3>{item.title}</h3>}
            <p>{item.summary}</p>
          </span>
          <span class="go" aria-hidden="true">
            <Icon name="arrow" size={18} />
          </span>
        </a>
      </li>
    ))
  }
</ul>
