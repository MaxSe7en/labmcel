---
import { site } from "../content/site";
import Mark from "./Mark.astro";
import Icon from "./Icon.astro";

const path = Astro.url.pathname;
const on = (href: string) => (href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`));
---

<header class="site-header">
  <div class="wrap bar">
    <a class="wordmark" href="/" aria-label={site.ui.home}>
      <Mark size={40} />
      <span>
        <strong>{site.name}</strong>
        <small>{site.base}</small>
      </span>
    </a>

    <div class="bar-end">
      <a class="btn btn-clay btn-sm quote-mobile" href="/contact">{site.cta.quote}</a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label={site.ui.menu} data-open={site.ui.menu} data-close={site.ui.close}>
        <Icon name="menu" />
        <Icon name="close" />
      </button>
    </div>

    <nav id="site-nav" class="site-nav">
      {
        site.nav.map((item) => (
          <a href={item.href} aria-current={on(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
      <a class="btn btn-clay btn-sm" href="/contact">{site.cta.quote}</a>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector(".nav-toggle");
  const nav = document.getElementById("site-nav");
  if (button && nav) {
    const openLabel = button.getAttribute("data-open") ?? "Open menu";
    const closeLabel = button.getAttribute("data-close") ?? "Close menu";
    const set = (open: boolean) => {
      nav.classList.toggle("open", open);
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute("aria-label", open ? closeLabel : openLabel);
    };
    button.addEventListener("click", () => set(button.getAttribute("aria-expanded") !== "true"));
    nav.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => set(false)));
  }
</script>
