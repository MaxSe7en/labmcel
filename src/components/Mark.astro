---
interface Props {
  size?: number;
}

const { size = 42 } = Astro.props;
---

<svg class="mark" width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
  <circle
    cx="32"
    cy="32"
    r="26"
    fill="none"
    stroke="#1c4e86"
    stroke-width="3.25"
    stroke-linecap="round"
    stroke-dasharray="78 86"
    transform="rotate(200 32 32)"
  />
  <circle
    cx="32"
    cy="32"
    r="26"
    fill="none"
    stroke="#0e6f66"
    stroke-width="3.25"
    stroke-linecap="round"
    stroke-dasharray="62 102"
    transform="rotate(28 32 32)"
  />
  <rect x="28.5" y="14" width="7" height="36" rx="1.4" fill="#1c4e86" />
  <rect x="14" y="28.5" width="36" height="7" rx="1.4" fill="#1c4e86" />
  <rect x="32" y="28.5" width="18" height="7" fill="#0e6f66" />
  <rect x="32" y="32" width="7" height="18" fill="#0e6f66" />
  <g fill="none" stroke="var(--paper)" stroke-width="2.5" stroke-linecap="round">
    <rect x="22.5" y="26.5" width="13" height="11" rx="5.5" transform="rotate(-42 29 32)" />
    <rect x="29" y="26.5" width="13" height="11" rx="5.5" transform="rotate(-42 35.5 32)" />
  </g>
</svg>
